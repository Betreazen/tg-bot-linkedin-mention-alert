# Скопируй в .env и заполни значения. .env в git НЕ коммитится.

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ORG_URNS=urn:li:organization:XXXXX
# список через запятую — задел на несколько страниц:
# LINKEDIN_ORG_URNS=urn:li:organization:XXXXX,urn:li:organization:YYYYY
LINKEDIN_API_VERSION=202606

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

POLL_INTERVAL_MINUTES=15
POLL_OVERLAP_MINUTES=5
FAILURE_ALERT_THRESHOLD=3
REFRESH_TOKEN_WARNING_DAYS=14

DB_PATH=/data/bot.db
# HEARTBEAT_PATH=/tmp/bot-heartbeat   # файл живости для Docker HEALTHCHECK (менять не нужно)
TIMEZONE=Europe/Kyiv
LOG_LEVEL=INFO
